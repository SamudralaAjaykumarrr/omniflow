# Copy to terraform.tfvars and fill in real values before ever running
# `terraform plan`/`apply` against a real AWS account (never done by this
# session — see ADR 0007 and infra/terraform/README.md). No value below is
# a real secret; secrets themselves (JWT signing key, seeded demo-user
# passwords, RDS master password) are generated by Terraform itself
# (modules/secrets, modules/rds) and never live in a tfvars file.

aws_region = "us-east-1"

# Must be globally unique — S3 bucket names are global. A real value would
# typically be your AWS account ID or another account-specific string.
data_lake_bucket_suffix = "REPLACE_ME_WITH_ACCOUNT_SPECIFIC_SUFFIX"

# Must already exist: an ACM certificate issued and DNS-validated against a
# real, owned domain — out of this Terraform's scope (ACM validation needs
# a real Route 53 zone or equivalent DNS control this session doesn't have).
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME"

dashboard_hostname = "ops-dev.your-real-domain.example"

# Uncomment to restrict who can reach the ALB (recommended for anything
# beyond a throwaway dev sandbox):
# alb_ingress_cidrs = ["203.0.113.0/24"]

# Uncomment to receive CloudWatch alarm notifications (requires confirming
# a subscription email AWS sends — Terraform cannot do this for you):
# alarm_email = "you@example.com"
