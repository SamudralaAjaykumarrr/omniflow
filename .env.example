# Copy to .env and adjust if needed. These are local-development-only
# defaults for a single-machine demo — never used against a real deployment,
# never secrets in the sense of anything that guards real data or money.

POSTGRES_USER=omniflow
POSTGRES_PASSWORD=omniflow_dev_only
POSTGRES_DB=omniflow_orders

# Per-service database URLs (used inside the Compose network — "postgres" is
# the service name/hostname, not localhost).
ORDER_SERVICE_DATABASE_URL=postgresql+psycopg://omniflow:omniflow_dev_only@postgres:5432/omniflow_orders
INVENTORY_SERVICE_DATABASE_URL=postgresql+psycopg://omniflow:omniflow_dev_only@postgres:5432/omniflow_inventory

GATEWAY_ORDER_SERVICE_URL=http://order-service:8000
GATEWAY_INVENTORY_SERVICE_URL=http://inventory-service:8000
GATEWAY_RATE_LIMIT_PER_MINUTE=120

# Grafana's anonymous-access admin login (local demo only — see
# docker-compose.yml's `grafana` service).
GRAFANA_ADMIN_PASSWORD=omniflow_dev_only

# MinIO (S3-compatible data lake for the Phase 4 data platform — Bronze/
# Silver/Gold Parquet, checkpoints, DQ reports). Path-style + a fixed
# endpoint is what lets the same Spark jobs target real S3 unchanged in the
# AWS deployment story (docs/data-pipeline.md).
MINIO_ROOT_USER=omniflow
MINIO_ROOT_PASSWORD=omniflow_dev_only
DATA_LAKE_BUCKET=omniflow

# Phase 6 demand forecasting (app.forecasting.config.ForecastSettings) — all
# optional, every one already has a sensible code default; only set these to
# override (e.g. via `make forecast-run ARGS=...` or FORECAST_* env vars for
# a smaller/faster local run). See docs/phase-6-demand-forecasting.md.
# FORECAST_SEED=42
# FORECAST_HISTORY_START_DATE=2024-07-01
# FORECAST_HISTORY_END_DATE=2026-06-30
# FORECAST_NUM_SKUS=20
# FORECAST_NUM_LOCATIONS=4
# FORECAST_FORECAST_HORIZON_DAYS=14
# FORECAST_MIN_HISTORY_DAYS=56
# FORECAST_CHAMPION_METRIC=wape
