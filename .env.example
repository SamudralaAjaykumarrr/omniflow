# Copy to .env and adjust if needed. These are local-development-only
# defaults for a single-machine demo — never used against a real deployment,
# never secrets in the sense of anything that guards real data or money.

POSTGRES_USER=omniflow
POSTGRES_PASSWORD=omniflow_dev_only
POSTGRES_DB=omniflow_orders

# Per-service database URLs (used inside the Compose network — "postgres" is
# the service name/hostname, not localhost).
ORDER_SERVICE_DATABASE_URL=postgresql+psycopg://omniflow:omniflow_dev_only@postgres:5432/omniflow_orders
INVENTORY_SERVICE_DATABASE_URL=postgresql+psycopg://omniflow:omniflow_dev_only@postgres:5432/omniflow_inventory

GATEWAY_ORDER_SERVICE_URL=http://order-service:8000
GATEWAY_INVENTORY_SERVICE_URL=http://inventory-service:8000
GATEWAY_RATE_LIMIT_PER_MINUTE=120
